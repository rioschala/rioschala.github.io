{
	"type": "module",
	"name": "astro-cactus",
	"version": "4.11.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"link": "node scripts/autolink.mjs",
		"newpost": "node scripts/new-post.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.3",
		"@astrojs/mdx": "8.1.0",
		"@astrojs/react": "7.1.0",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/starlight": "0.42.6",
		"@astrojs/tailwind": "6.0.2",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"astro": "7.4.1",
		"astro-expressive-code": "^0.43.1",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^7.1.4",
		"hastscript": "^9.0.1",
		"katex": "^0.16.44",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"postcss": "^8.5.8",
		"react": "^18.3.1",
		"react-compiler-runtime": "19.0.0-beta-63e3235-20250105",
		"react-dom": "^18.3.1",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"remark-directive": "^3.0.1",
		"remark-math": "^6.0.0",
		"satori": "0.11.2",
		"satori-html": "^0.3.2",
		"sharp": "^0.33.5",
		"tslib": "^2.8.1",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
