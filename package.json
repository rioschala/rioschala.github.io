		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"autoprefixer": "^10.4.27",
		"baseline-browser-mapping": "^2.10.14",
		"pagefind": "^1.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"reading-time": "^1.5.0",
		"remark-unwrap-images": "^4.0.1",
		"tailwindcss": "^3.4.19",
